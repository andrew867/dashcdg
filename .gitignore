# Binary media (default: ignore everywhere)
*.mp3
*.cdg

# Bundled MP3+G sample library — tracked for TX/player defaults + release zip
!cdg/
!cdg/*.mp3
!cdg/*.cdg

*.o
/.idea
*.tar

# Build outputs: ignore by default; track only release trees (bin/lib/dist + sneakernet).
# Parent dirs must be un-ignored before children (git does not re-include under ignored parents).
/build/*
!/build/bin/
/build/bin/*
!/build/bin/**
!/build/amd64/
/build/amd64/*
!/build/amd64/bin/
!/build/amd64/bin/**
!/build/amd64/lib/
!/build/amd64/lib/**
!/build/x86/
/build/x86/*
!/build/x86/bin/
!/build/x86/bin/**
!/build/x86/lib/
!/build/x86/lib/**
!/build/x86-retro/
/build/x86-retro/*
!/build/x86-retro/bin/
!/build/x86-retro/bin/**
!/build/x86-retro/lib/
!/build/x86-retro/lib/**
!/build/dist/
/build/dist/*
!/build/dist/**

# Local clones / experiments (use scripts/fetch_audio_codec_vendors.sh into audio_modules/*/vendor/)
third_party/*
!third_party/README.md

# ESP-IDF generated config (per-machine)
platform/espidf/projects/**/sdkconfig
platform/espidf/projects/**/sdkconfig.old
platform/espidf/projects/**/build/
platform/espidf/projects/**/managed_components/
platform/espidf/projects/**/dependencies.lock
# Optional large upstream clones (see scripts/fetch_opus_portaudio_vendors.sh)
audio_modules/opus/vendor/
audio_modules/portaudio/vendor/
