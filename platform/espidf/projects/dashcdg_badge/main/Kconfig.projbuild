menu "DashCDG badge"

    config DASHCDG_BADGE_EXEC_TRACE
        bool "Executive: structured UART trace lines"
        default y
        help
            When enabled, badge_exec emits short structured `[exec-trace]` lines on every boot
            event, health transition, task registration, and orchestrator decision. Lines are
            single-line, ASCII only, and rate-limited by event cadence (not by a tick), so the
            UART load is small. Disable to silence the lines without removing the executive.
            See docs/ops/esp32-badge-freertos-telemetry-runbook.md for the parser contract.

    config DASHCDG_BADGE_EXEC_LOCK_TIMEOUT_MS
        int "Executive: health/task table mutex wait timeout (ms)"
        range 5 200
        default 20
        help
            Maximum time a publisher will wait to update the executive health/task table. The
            mutex is only held for trivial copies, so timeouts here indicate a real RTOS problem.
            On timeout the publisher returns ESP_ERR_TIMEOUT and the caller logs/drops; heartbeats
            use a non-blocking attempt and silently skip on contention.

    config DASHCDG_BADGE_OPUS_MONO_ONLY
        bool "Opus RX: mono decoder only (saves internal RAM)"
        default y
        help
            Restrict the badge Opus path to a mono decoder: smaller opus_decoder_get_size() blob and
            no stereo PCM scratch in the decoder. Stereo Opus streams will fail decode (use mono from TX).
            Turn off if you must play stereo Opus on the badge.

    config DASHCDG_BADGE_RX_CDG_ON_HEAP
        bool "CDG + jitter on heap (free when RX stops)"
        default n
        help
            Places CDG decode state and the batch jitter buffer in internal heap instead of .bss.
            dashcdg_badge_rx_stop() frees them (plus blit scratch and v4 anchor assembly) so RAM is
            reclaimed when leaving karaoke. Static .bss mode avoids that free and keeps buffers warm
            for quick re-entry; heap mode trades a bit of fragmentation risk for smaller idle firmware RAM.

    config DASHCDG_BADGE_DEBUG_AUTO_LAUNCH_KARAOKE_AFTER_DHCP
        bool "DEBUG: auto-launch Karaoke once after first DHCP"
        default n
        help
            Debug automation helper. When enabled, after the first STA DHCP lease on each boot,
            the app auto-navigates to Karaoke once per boot. Karaoke decode toggles remain whatever
            is saved in NVS / set in karaoke settings UI (never forced).
            Intended for soak/debug loops; keep off for normal interactive use.

    config DASHCDG_BADGE_CDG_JB_HEADROOM_EXTRA
        int "Extra CDG jitter headroom slots (0-12)"
        range 0 12
        default 0
        help
            Added to the CDG batch jitter headroom used for insert/evict pressure. Higher values keep
            more empty slots for bursty Wi-Fi and reorder, at the cost of earlier evictions when the
            ring is tight.

    config DASHCDG_BADGE_ENABLE_REPAIR_NACK
        bool "v4 CDG repair NACK uplink to TX"
        default n
        help
            When enabled, sends v4_repair_nack when FEC groups have missing members (split repair port).
            Disabled by default on ESP32 to save code size and DRAM; many setups do not use badge NACK.

    config DASHCDG_BADGE_REPAIR_NACK_THROTTLE
        bool "Adaptive throttle for v4 repair NACK uplink"
        depends on DASHCDG_BADGE_ENABLE_REPAIR_NACK
        default y
        help
            Enforces a minimum time between repair NACK send attempts. The spacing grows when STA
            RSSI is below a reference (weaker link), to cap uplink airtime and reduce self-induced
            contention. PHY/MCS is not exposed on ESP32 in a portable way; RSSI is used as the link
            quality proxy.

    config DASHCDG_BADGE_REPAIR_NACK_MIN_GAP_MS
        int "NACK min-spacing base (ms)"
        depends on DASHCDG_BADGE_REPAIR_NACK_THROTTLE
        range 20 500
        default 50

    config DASHCDG_BADGE_REPAIR_NACK_MAX_GAP_MS
        int "NACK min-spacing ceiling (ms)"
        depends on DASHCDG_BADGE_REPAIR_NACK_THROTTLE
        range 50 800
        default 400

    config DASHCDG_BADGE_REPAIR_NACK_RSSI_REF_DB
        int "RSSI reference (dBm); below this adds extra spacing"
        depends on DASHCDG_BADGE_REPAIR_NACK_THROTTLE
        range -90 -40
        default -65

    config DASHCDG_BADGE_REPAIR_NACK_RSSI_EXTRA_MS_PER_DB
        int "Extra ms per dB below RSSI reference"
        depends on DASHCDG_BADGE_REPAIR_NACK_THROTTLE
        range 0 20
        default 2

    config DASHCDG_BADGE_REPAIR_NACK_RSSI_EXTRA_CAP_MS
        int "Max extra ms from RSSI term"
        depends on DASHCDG_BADGE_REPAIR_NACK_THROTTLE
        range 0 400
        default 200

    config DASHCDG_BADGE_PERF_PROBES
        bool "Perf probes: mutex/blit timing counters (UART optional)"
        default n
        help
            When enabled, records high-water mutex dwell and SPI blit time for T0 baselines.
            Counters are exposed via dashcdg_badge_rx_get_stats / optional periodic ESP_LOGI.

    config DASHCDG_BADGE_CDG_DEFERRED_BLIT
        bool "CDG overlay: deferred SPI blit worker (experimental; validate on HW)"
        default n
        help
            LVGL enqueues RGB565 band jobs; a dedicated FreeRTOS task performs esp_lcd_panel_draw_bitmap
            + inter-band settle delay so badge_rx s_mtx is not held across SPI/DMA.

    config DASHCDG_BADGE_SP_BLIT_POOL_SLOTS
        int "Deferred CDG blit: RGB565 band pool slots (2-16)"
        depends on DASHCDG_BADGE_CDG_DEFERRED_BLIT
        range 2 16
        default 8
        help
            Each slot holds one band (288x12 RGB565). More slots reduce drops under SPI back-pressure;
            each slot costs ~6.9 KiB internal DRAM.

    config DASHCDG_BADGE_SP_BLIT_TASK_PRIO
        int "Deferred CDG blit worker task priority (FreeRTOS)"
        depends on DASHCDG_BADGE_CDG_DEFERRED_BLIT
        range 1 15
        default 4
        help
            Keep below or near the badge RX task (5) so real-time UDP decode is not starved.

    config DASHCDG_BADGE_RX_PUMP_MUTEX_MS
        int "RX media pump: s_mtx wait timeout ms (0 = wait forever)"
        range 0 5000
        default 400
        help
            Bounds xSemaphoreTake in badge_rx_pump_main_fd. On rare timeout the datagram is dropped
            (counter rx_mtx_pump_timeouts). Use 0 only for legacy debugging.

    config DASHCDG_BADGE_RX_REPAIR_MUTEX_MS
        int "RX repair recv: s_mtx wait timeout ms (0 = wait forever)"
        range 0 5000
        default 400
        help
            Same semantics as pump timeout for repair/FEC recv loops.

    config DASHCDG_BADGE_DAC_WRITE_TIMEOUT_MS
        int "Karaoke DAC: dac_continuous_write max block ms (0 = infinite)"
        range 0 200
        default 0
        help
            Pass-through to ESP-IDF `dac_continuous_write(..., timeout_ms)` (negative only via 0 here).
            Short finite values (e.g. 12 ms) cause `Get available descriptor timeout` under Wi-Fi/LVGL load.
            Use 0 for infinite wait unless debugging stuck DAC.

    config DASHCDG_BADGE_RX_SELECT_TIMEOUT_MS
        int "RX select timeout when video decode is on (ms)"
        range 4 80
        default 12
        help
            `select` wake period for CDG+LVGL coex vs Wi-Fi modem sleep / IGMP refresh. Lower = more
            CPU wakeups; higher = riskier audio underrun. Tuned with `platform_hw` karaoke PS_NONE.

    config DASHCDG_BADGE_RX_SELECT_TIMEOUT_AUDIO_ONLY_MS
        int "RX select timeout when audio-only decode (ms)"
        range 2 50
        default 6
        help
            Shorter wake when CDG drain is off — keeps DAC + Opus drain cadence tighter.

    config DASHCDG_BADGE_AUDIO_DIAG_UART_INFO
        bool "UART: audio chop / proof lines at INFO (default DEBUG)"
        default n
        help
            When enabled, badge_rx prints `audio_chop`, `AUDIO_UART_PROOF`, and audio_only cumulative
            lines at ESP_LOGI once per second while decode is on — useful for field RCA without raising
            global log level. Keep off for normal builds (UART bandwidth + CPU).

endmenu
